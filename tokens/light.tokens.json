{
  "color": {
    "$type": "color",
    "text": {
      "primary": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0706, 0.0941, 0.1059],
          "hex": "#12181B"
        },
        "$description": "Main text and icons; also the focus ring"
      },
      "secondary": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.2784, 0.3255, 0.3529],
          "hex": "#47535A"
        },
        "$description": "Supporting text"
      },
      "tertiary": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.4549, 0.5059, 0.5412],
          "hex": "#74818A"
        },
        "$description": "Hints, captions, inactive controls"
      },
      "inverse": {
        "$value": "{color.surface.default}",
        "$description": "Text on inverse surfaces: tooltips, the chart's value tip"
      }
    },
    "surface": {
      "raised": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [1, 1, 1],
          "hex": "#FFFFFF"
        },
        "$description": "Inputs, selected segment"
      },
      "hover": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0706, 0.0941, 0.1059],
          "alpha": 0.05,
          "hex": "#12181B"
        },
        "$description": "Hover state layer"
      },
      "selected": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0706, 0.0941, 0.1059],
          "alpha": 0.09,
          "hex": "#12181B"
        },
        "$description": "Selected row"
      },
      "inverse": {
        "$value": "{color.text.primary}",
        "$description": "Primary buttons, pressed icon buttons, chart tooltip"
      },
      "default": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9804, 0.9843, 0.9765],
          "hex": "#FAFBF9"
        },
        "$description": "Opaque panel background; text on inverse surfaces"
      },
      "overlay": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9804, 0.9843, 0.9765],
          "alpha": 0.9,
          "hex": "#FAFBF9"
        },
        "$description": "Translucent floating panels over the map (used with backdrop blur)"
      },
      "inset": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9216, 0.9333, 0.9216],
          "hex": "#EBEEEB"
        },
        "$description": "Segmented control track, counts, inset boxes"
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0706, 0.0941, 0.1059],
          "alpha": 0.11,
          "hex": "#12181B"
        },
        "$description": "Dividers and panel borders"
      },
      "strong": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0706, 0.0941, 0.1059],
          "alpha": 0.22,
          "hex": "#12181B"
        },
        "$description": "Input borders, dashed tags, axis lines"
      },
      "focus": {
        "$value": "{color.text.primary}",
        "$description": "Keyboard focus ring"
      }
    },
    "status": {
      "info": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.1765, 0.3725, 0.7686],
          "hex": "#2D5FC4"
        },
        "$description": "Early, diversions"
      },
      "success": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0745, 0.5686, 0.3529],
          "hex": "#13915A"
        },
        "$description": "Healthy, on time, live share at or above 70%"
      },
      "warning": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.6902, 0.4157, 0],
          "hex": "#B06A00"
        },
        "$description": "Partial, live share 40–69%"
      },
      "danger": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.7608, 0.2549, 0.0471],
          "hex": "#C2410C"
        },
        "$description": "Late by 3 min or more, live share under 40%, delay disruptions"
      }
    },
    "chart": {
      "series": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.1686, 0.4235, 0.549],
          "hex": "#2B6C8C"
        },
        "$description": "Single data series (vehicles in service curve)"
      }
    },
    "transit": {
      "mode": {
        "bus": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [0.851, 0.6039, 0],
            "hex": "#D99A00"
          },
          "$description": "All bus lines"
        },
        "regional": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [0.1373, 0.1725, 0.1922],
            "hex": "#232C31"
          },
          "$description": "Regional and Øresund trains"
        },
        "on-bus": {
          "$value": "{color.text.on-color.dark}",
          "$description": "Label text on bus badges"
        },
        "on-regional": {
          "$value": "{color.surface.default}",
          "$description": "Label text on regional train badges"
        }
      },
      "delay": {
        "on-time": {
          "$value": "{color.status.success}",
          "$description": "Delay text when on time"
        },
        "slight": {
          "$value": "{color.text.primary}",
          "$description": "Late by 1–2 min"
        },
        "late": {
          "$value": "{color.status.danger}",
          "$description": "Late by 3 min or more"
        },
        "early": {
          "$value": "{color.status.info}",
          "$description": "Delay text when early"
        },
        "unknown": {
          "$value": "{color.text.tertiary}",
          "$description": "Delay text when there is no real-time data"
        }
      },
      "severity": {
        "delay": {
          "$value": "{color.status.danger}",
          "$description": "Icon and label for delays"
        },
        "data": {
          "$value": "{color.text.secondary}",
          "$description": "Data feed problems"
        },
        "diversion": {
          "$value": "{color.status.info}",
          "$description": "Icon and label for diversions"
        },
        "planned": {
          "$value": "{color.text.secondary}",
          "$description": "Icon and label for planned works"
        }
      }
    },
    "data-state": {
      "no-signal": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.6039, 0.6431, 0.6627],
          "hex": "#9AA4A9"
        },
        "$description": "Prik fill when a vehicle has been silent for 5+ min"
      },
      "halo": {
        "$value": "{color.map.land}",
        "$description": "Map only: ring under each dot"
      },
      "outline": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0706, 0.0941, 0.1059],
          "alpha": 0.45,
          "hex": "#12181B"
        },
        "$description": "Map only: outline around light line colours on a light map"
      }
    },
    "map": {
      "water": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.7686, 0.8314, 0.8667],
          "hex": "#C4D4DD"
        },
        "$description": "Sea, lakes and the page behind the map"
      },
      "land": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9294, 0.9373, 0.9216],
          "hex": "#EDEFEB"
        },
        "$description": "Land, the map's main ground"
      },
      "park": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.8471, 0.8941, 0.8235],
          "hex": "#D8E4D2"
        },
        "$description": "Parks and green areas"
      },
      "street": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [1, 1, 1],
          "hex": "#FFFFFF"
        },
        "$description": "Streets"
      },
      "airport": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.8863, 0.898, 0.8824],
          "hex": "#E2E5E1"
        },
        "$description": "Airport grounds"
      },
      "runway": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.7961, 0.8196, 0.8078],
          "hex": "#CBD1CE"
        },
        "$description": "Runways and taxiways"
      },
      "building": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.8863, 0.898, 0.8784],
          "hex": "#E2E5E0"
        },
        "$description": "Building footprints at close zoom"
      },
      "rail": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.7373, 0.7686, 0.7569],
          "hex": "#BCC4C1"
        },
        "$description": "Rail tracks without a coloured line on them"
      },
      "label": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.4, 0.451, 0.4784],
          "hex": "#66737A"
        },
        "$description": "Place names"
      },
      "water-label": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.3725, 0.4784, 0.5333],
          "hex": "#5F7A88"
        },
        "$description": "Water names"
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "panel": {
      "$value": [
        {
          "color": {
            "colorSpace": "srgb",
            "components": [0.0706, 0.0941, 0.1059],
            "alpha": 0.06,
            "hex": "#12181B"
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 1,
            "unit": "px"
          },
          "blur": {
            "value": 2,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        },
        {
          "color": {
            "colorSpace": "srgb",
            "components": [0.0706, 0.0941, 0.1059],
            "alpha": 0.1,
            "hex": "#12181B"
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 10,
            "unit": "px"
          },
          "blur": {
            "value": 30,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        }
      ],
      "$description": "Floating panels"
    }
  },
  "$description": "Perron light theme. Values from the prototype :root."
}
