{
  "name": "Perron",
  "version": "2025.10",
  "description": "How the files combine. base always applies; the theme modifier picks light or dark; the motion modifier overrides durations when the person asks for reduced motion.",
  "sets": {
    "base": {
      "sources": [
        {
          "$ref": "base.tokens.json"
        }
      ]
    }
  },
  "modifiers": {
    "theme": {
      "description": "Colour theme",
      "contexts": {
        "light": [
          {
            "$ref": "light.tokens.json"
          }
        ],
        "dark": [
          {
            "$ref": "dark.tokens.json"
          }
        ]
      },
      "default": "light"
    },
    "motion": {
      "description": "Motion preference. Mapped to prefers-reduced-motion by the build.",
      "contexts": {
        "full": [],
        "reduced": [
          {
            "$ref": "motion-reduced.tokens.json"
          }
        ]
      },
      "default": "full"
    }
  },
  "resolutionOrder": [
    {
      "$ref": "#/sets/base"
    },
    {
      "$ref": "#/modifiers/theme"
    },
    {
      "$ref": "#/modifiers/motion"
    }
  ]
}
