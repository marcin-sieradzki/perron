{
  "name": "@mylder/perron",
  "version": "0.1.0",
  "description": "Perron, the design system of Mylder: design tokens, styles, icons and the Mylder mark.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcin-sieradzki/perron.git",
    "directory": "packages/perron"
  },
  "exports": {
    "./perron.css": "./styles/perron.css",
