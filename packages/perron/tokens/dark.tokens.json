{
  "color": {
    "$type": "color",
    "text": {
      "primary": {
        "$value": "{palette.neutral.100}",
        "$description": "Main text and icons; also the focus ring"
      },
      "secondary": {
        "$value": "{palette.neutral.300}",
        "$description": "Supporting text"
      },
      "tertiary": {
        "$value": "{palette.neutral.500}",
        "$description": "Hints, captions, inactive controls"
      },
      "inverse": {
        "$value": "{color.surface.default}",
        "$description": "Text on inverse surfaces: tooltips, the chart's value tip"
      },
      "success": {
        "$value": "{palette.green.300}",
        "$description": "Text in the success colour: on time, running normally"
      },
      "warning": {
        "$value": "{palette.orange.300}",
        "$description": "Text in the warning colour"
      },
      "danger": {
        "$value": "{palette.red.300}",
        "$description": "Text in the danger colour: late, delay disruptions"
      },
      "info": {
        "$value": "{palette.blue.300}",
        "$description": "Text in the info colour: early, diversions"
      },
      "brand": {
        "$value": "{palette.yellow.300}",
        "$description": "Text in the brand colour: brand outline buttons and emphasis on the hero page; never links"
      }
    },
    "surface": {
      "default": {
        "$value": "{palette.neutral.900}",
        "$description": "Opaque panel background; text on inverse surfaces"
      },
      "raised": {
        "$value": "{palette.neutral.800}",
        "$description": "Inputs, selected segment"
      },
      "inset": {
        "$value": "{palette.neutral.700}",
        "$description": "Segmented control track, counts, inset boxes"
      },
      "overlay": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0706, 0.0941, 0.1059],
          "alpha": 0.88,
          "hex": "#12181B"
        },
        "$description": "Translucent floating panels over the map (used with backdrop blur)"
      },
      "hover": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9216, 0.9333, 0.9216],
          "alpha": 0.06,
          "hex": "#EBEEEB"
        },
        "$description": "Hover state layer"
      },
      "selected": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9216, 0.9333, 0.9216],
          "alpha": 0.09,
          "hex": "#EBEEEB"
        },
        "$description": "Selected row; the pressed layer of a quiet or outline control, in place of color.surface.hover and denser"
      },
      "inverse": {
        "$value": "{color.text.primary}",
        "$description": "Primary buttons, pressed icon buttons, chart tooltip"
      },
      "inverse-hover": {
        "$value": "{palette.neutral.300}",
        "$description": "Hover fill of a primary button, a step from color.surface.inverse the eye sees"
      },
      "inverse-pressed": {
        "$value": "{palette.neutral.400}",
        "$description": "Pressed fill of a primary button, a step further from color.surface.inverse than its hover"
      },
      "success": {
        "$value": "{palette.green.900}",
        "$description": "Tinted background for a success message"
      },
      "warning": {
        "$value": "{palette.orange.900}",
        "$description": "Tinted background for a warning message or count"
      },
      "danger": {
        "$value": "{palette.red.900}",
        "$description": "Tinted background for a danger message"
      },
      "info": {
        "$value": "{palette.blue.900}",
        "$description": "Tinted background for an info message"
      },
      "brand": {
        "$value": "{palette.yellow.300}",
        "$description": "Brand fill: brand buttons, hero bands and calls to action. Text on it is color.text.on-color.dark"
      },
      "brand-hover": {
        "$value": "{palette.yellow.500}",
        "$description": "Hover fill of a brand button, a step from color.surface.brand the eye sees"
      },
      "brand-pressed": {
        "$value": "{palette.yellow.600}",
        "$description": "Pressed fill of a brand button, a step further from color.surface.brand than its hover"
      },
      "brand-subtle": {
        "$value": "{palette.yellow.900}",
        "$description": "Tinted brand background"
      }
    },
    "border": {
      "subtle": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9216, 0.9333, 0.9216],
          "alpha": 0.1,
          "hex": "#EBEEEB"
        },
        "$description": "Dividers and panel borders"
      },
      "strong": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9216, 0.9333, 0.9216],
          "alpha": 0.2,
          "hex": "#EBEEEB"
        },
        "$description": "Dashed tags, axis lines: lines that decorate rather than show where a control is"
      },
      "control": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9216, 0.9333, 0.9216],
          "alpha": 0.39,
          "hex": "#EBEEEB"
        },
        "$description": "Edges that show where a control is: inputs, outline buttons. 3:1 or better on every surface"
      },
      "brand": {
        "$value": "{palette.yellow.300}",
        "$description": "Edge of a brand button, solid or outline, so the yellow reaches 3:1 on every surface"
      },
      "focus": {
        "$value": "{color.text.primary}",
        "$description": "Keyboard focus ring"
      }
    },
    "status": {
      "$description": "Status fills: dots, meters, icons and counts. For text in a status colour use color.text.<status>; for a tinted background color.surface.<status>.",
      "success": {
        "$value": "{palette.green.300}",
        "$description": "Healthy, on time, live share at or above 70%"
      },
      "warning": {
        "$value": "{palette.orange.300}",
        "$description": "Partial, live share 40–69%"
      },
      "danger": {
        "$value": "{palette.red.300}",
        "$description": "Late by 3 min or more, live share under 40%, delay disruptions"
      },
      "info": {
        "$value": "{palette.blue.300}",
        "$description": "Early, diversions"
      }
    },
    "chart": {
      "series": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.4275, 0.702, 0.8471],
          "hex": "#6DB3D8"
        },
        "$description": "Single data series (vehicles in service curve)"
      }
    },
    "transit": {
      "mode": {
        "bus": {
          "$value": "{palette.yellow.300}",
          "$description": "All bus lines"
        },
        "regional": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [0.9333, 0.9451, 0.9412],
            "hex": "#EEF1F0"
          },
          "$description": "Regional and Øresund trains"
        },
        "on-bus": {
          "$value": "{color.text.on-color.dark}",
          "$description": "Label text on bus badges"
        },
        "on-regional": {
          "$value": "{color.surface.default}",
          "$description": "Label text on regional train badges"
        }
      },
      "delay": {
        "on-time": {
          "$value": "{color.text.success}",
          "$description": "Delay text when on time"
        },
        "slight": {
          "$value": "{color.text.primary}",
          "$description": "Late by 1–2 min"
        },
        "late": {
          "$value": "{color.text.danger}",
          "$description": "Late by 3 min or more"
        },
        "early": {
          "$value": "{color.text.info}",
          "$description": "Delay text when early"
        },
        "unknown": {
          "$value": "{color.text.tertiary}",
          "$description": "Delay text when there is no real-time data"
        }
      },
      "severity": {
        "delay": {
          "$value": "{color.text.danger}",
          "$description": "Icon and label for delays"
        },
        "data": {
          "$value": "{color.text.secondary}",
          "$description": "Data feed problems"
        },
        "diversion": {
          "$value": "{color.text.info}",
          "$description": "Icon and label for diversions"
        },
        "planned": {
          "$value": "{color.text.secondary}",
          "$description": "Icon and label for planned works"
        }
      }
    },
    "data-state": {
      "no-signal": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.3725, 0.4196, 0.4431],
          "hex": "#5F6B71"
        },
        "$description": "Prik fill when a vehicle has been silent for 5+ min"
      },
      "halo": {
        "$value": "{color.map.land}",
        "$description": "Map only: ring under each dot"
      },
      "outline": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0, 0, 0],
          "alpha": 0,
          "hex": "#000000"
        },
        "$description": "Map only: outline around light line colours on a light map"
      }
    },
    "map": {
      "water": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0392, 0.0667, 0.0824],
          "hex": "#0A1115"
        },
        "$description": "Sea, lakes and the page behind the map"
      },
      "land": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0824, 0.1059, 0.1176],
          "hex": "#151B1E"
        },
        "$description": "Land, the map's main ground"
      },
      "park": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0863, 0.1373, 0.1176],
          "hex": "#16231E"
        },
        "$description": "Parks and green areas"
      },
      "street": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.1451, 0.1765, 0.1922],
          "hex": "#252D31"
        },
        "$description": "Streets"
      },
      "airport": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.1098, 0.1373, 0.149],
          "hex": "#1C2326"
        },
        "$description": "Airport grounds"
      },
      "runway": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.1686, 0.2039, 0.2196],
          "hex": "#2B3438"
        },
        "$description": "Runways and taxiways"
      },
      "building": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.102, 0.1294, 0.1451],
          "hex": "#1A2125"
        },
        "$description": "Building footprints at close zoom"
      },
      "rail": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.1961, 0.2353, 0.2549],
          "hex": "#323C41"
        },
        "$description": "Rail tracks without a coloured line on them"
      },
      "label": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.4941, 0.5451, 0.5686],
          "hex": "#7E8B91"
        },
        "$description": "Place names"
      },
      "water-label": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.2941, 0.4039, 0.4549],
          "hex": "#4B6774"
        },
        "$description": "Water names"
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "panel": {
      "$value": [
        {
          "color": {
            "colorSpace": "srgb",
            "components": [0, 0, 0],
            "alpha": 0.35,
            "hex": "#000000"
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 1,
            "unit": "px"
          },
          "blur": {
            "value": 2,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        },
        {
          "color": {
            "colorSpace": "srgb",
            "components": [0, 0, 0],
            "alpha": 0.38,
            "hex": "#000000"
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 14,
            "unit": "px"
          },
          "blur": {
            "value": 36,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        }
      ],
      "$description": "Floating panels"
    },
    "thumb": {
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [0.0, 0.0, 0.0],
          "alpha": 0.4,
          "hex": "#000000"
        },
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 1,
          "unit": "px"
        },
        "blur": {
          "value": 2,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      },
      "$description": "Selected segment in a segmented control"
    }
  },
  "$description": "Perron dark theme. Values from the prototype dark media query and [data-theme=\"dark\"]."
}
