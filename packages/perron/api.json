{
  "Prik": {
    "extends": [
      "Omit<ComponentProps<'svg'>, 'children' | 'color'>"
    ],
    "props": {
      "ageingLabel": {
        "optional": true,
        "type": [
          "string"
        ]
      },
      "estimatedLabel": {
        "optional": true,
        "type": [
          "string"
        ]
      },
      "line": {
        "optional": false,
        "type": [
          "\"a\"",
          "\"b\"",
          "\"bus\"",
          "\"c\"",
          "\"e\"",
          "\"f\"",
          "\"h\"",
          "\"m1\"",
          "\"m2\"",
          "\"m3\"",
          "\"m4\"",
          "\"regional\""
        ]
      },
      "liveLabel": {
        "optional": true,
        "type": [
          "string"
        ]
      },
      "noSignalLabel": {
        "optional": true,
        "type": [
          "string"
        ]
      },
      "size": {
        "optional": true,
        "type": [
          "\"large\"",
          "\"medium\"",
          "\"small\""
        ]
      },
      "timetableOnlyLabel": {
        "optional": true,
        "type": [
          "string"
        ]
      },
      "variant": {
        "optional": true,
        "type": [
          "\"ageing\"",
          "\"estimated\"",
          "\"live\"",
          "\"no-signal\"",
          "\"timetable-only\""
        ]
      }
    }
  }
}
