{
  "Button": {
    "extends": [
      "Omit< BaseButton.Props, 'className' | 'style' | 'color' | 'children' | 'disabled' | 'ref' >"
    ],
    "props": {
      "children": {
        "optional": true,
        "type": [
          "ReactNode"
        ]
      },
      "className": {
        "optional": true,
        "type": [
          "string"
        ]
      },
      "color": {
        "optional": true,
        "type": [
          "\"brand\"",
          "\"neutral\""
        ]
      },
      "disabled": {
        "optional": true,
        "type": [
          "boolean"
        ]
      },
      "endIcon": {
        "optional": true,
        "type": [
          "ReactNode"
        ]
      },
      "fullWidth": {
        "optional": true,
        "type": [
          "boolean"
        ]
      },
      "ref": {
        "optional": true,
        "type": [
          "Ref<HTMLButtonElement>"
        ]
      },
      "size": {
        "optional": true,
        "type": [
          "\"medium\"",
          "\"small\""
        ]
      },
      "startIcon": {
        "optional": true,
        "type": [
          "ReactNode"
        ]
      },
      "style": {
        "optional": true,
        "type": [
          "CSSProperties"
        ]
      },
      "variant": {
        "optional": true,
        "type": [
          "\"outline\"",
          "\"solid\""
        ]
      }
    }
  },
  "Delay": {
    "extends": [
      "Omit< useRender.ComponentProps<'span'>, 'children' | 'render' | 'ref' >"
    ],
    "props": {
      "className": {
        "optional": true,
        "type": [
          "string"
        ]
      },
      "delayUnknownLabel": {
        "optional": true,
        "type": [
          "string"
        ]
      },
      "minutes": {
        "optional": false,
        "type": [
          "null",
          "number"
        ]
      },
      "minutesEarlyLabel": {
        "optional": true,
        "type": [
          "string"
        ]
      },
      "minutesLateLabel": {
        "optional": true,
        "type": [
          "string"
        ]
      },
      "minutesUnitLabel": {
        "optional": true,
        "type": [
          "string"
        ]
      },
      "onTimeLabel": {
        "optional": true,
        "type": [
          "string"
        ]
      },
      "ref": {
        "optional": true,
        "type": [
          "Ref<HTMLSpanElement>"
        ]
      },
      "render": {
        "optional": true,
        "type": [
          "ComponentRenderFn<HTMLProps, {}>",
          "ReactElement<unknown, string | JSXElementConstructor<any>>",
          "undefined"
        ]
      },
      "style": {
        "optional": true,
        "type": [
          "CSSProperties"
        ]
      }
    }
  },
  "EmptyState": {
    "extends": [
      "Omit< useRender.ComponentProps<'div'>, 'title' | 'children' >"
    ],
    "props": {
      "action": {
        "optional": true,
        "type": [
          "ReactNode"
        ]
      },
      "children": {
        "optional": true,
        "type": [
          "ReactNode"
        ]
      },
      "icon": {
        "optional": true,
        "type": [
          "ReactNode"
        ]
      },
      "slotProps": {
        "optional": true,
        "type": [
          "{ icon?: ComponentProps<\"div\", {}, HTMLProps> | undefined; title?: ComponentProps<\"p\", {}, HTMLProps> | undefined; description?: ComponentProps<\"div\", {}, HTMLProps> | undefined; action?: ComponentProps<\"div\", {}, HTMLProps> | undefined; }"
        ]
      },
      "title": {
        "optional": false,
        "type": [
          "ReactNode"
        ]
      }
    }
  },
  "StationIcon": {
    "extends": [
      "Omit<ComponentPropsWithRef<'span'>, 'children'>"
    ],
    "props": {
      "className": {
        "optional": true,
        "type": [
          "string"
        ]
      },
      "line": {
        "optional": true,
        "type": [
          "\"a\"",
          "\"b\"",
          "\"bus\"",
          "\"c\"",
          "\"e\"",
          "\"f\"",
          "\"h\"",
          "\"m1\"",
          "\"m2\"",
          "\"m3\"",
          "\"m4\"",
          "\"regional\""
        ]
      },
      "ref": {
        "optional": true,
        "type": [
          "Ref<HTMLSpanElement>"
        ]
      },
      "render": {
        "optional": true,
        "type": [
          "RenderProp<Record<string, unknown>>"
        ]
      },
      "size": {
        "optional": true,
        "type": [
          "\"large\"",
          "\"medium\"",
          "\"small\""
        ]
      },
      "style": {
        "optional": true,
        "type": [
          "CSSProperties"
        ]
      },
      "variant": {
        "optional": true,
        "type": [
          "\"filled\"",
          "\"outlined\""
        ]
      }
    }
  },
  "Toolbar": {
    "extends": [
      "Inherited< BaseToolbar.Root.Props, 'orientation' | 'disabled' >"
    ],
    "props": {
      "children": {
        "optional": true,
        "type": [
          "ReactNode"
        ]
      },
      "className": {
        "optional": true,
        "type": [
          "string"
        ]
      },
      "disabled": {
        "optional": true,
        "type": [
          "boolean"
        ]
      },
      "orientation": {
        "optional": true,
        "type": [
          "\"horizontal\"",
          "\"vertical\""
        ]
      },
      "ref": {
        "optional": true,
        "type": [
          "Ref<HTMLDivElement>"
        ]
      },
      "style": {
        "optional": true,
        "type": [
          "CSSProperties"
        ]
      }
    }
  }
}
