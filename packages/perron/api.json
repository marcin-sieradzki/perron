{
  "Button": {
    "extends": [
      "Omit< BaseButton.Props, 'className' | 'style' | 'color' | 'children' | 'disabled' | 'ref' >"
    ],
    "props": {
      "children": {
        "optional": true,
        "type": [
          "ReactNode"
        ]
      },
      "className": {
        "optional": true,
        "type": [
          "string"
        ]
      },
      "color": {
        "optional": true,
        "type": [
          "\"brand\"",
          "\"neutral\""
        ]
      },
      "disabled": {
        "optional": true,
        "type": [
          "boolean"
        ]
      },
      "endIcon": {
        "optional": true,
        "type": [
          "ReactNode"
        ]
      },
      "fullWidth": {
        "optional": true,
        "type": [
          "boolean"
        ]
      },
      "ref": {
        "optional": true,
        "type": [
          "Ref<HTMLButtonElement>"
        ]
      },
      "size": {
        "optional": true,
        "type": [
          "\"medium\"",
          "\"small\""
        ]
      },
      "startIcon": {
        "optional": true,
        "type": [
          "ReactNode"
        ]
      },
      "style": {
        "optional": true,
        "type": [
          "CSSProperties"
        ]
      },
      "variant": {
        "optional": true,
        "type": [
          "\"outline\"",
          "\"solid\""
        ]
      }
    }
  },
  "StationIcon": {
    "extends": [
      "Omit<ComponentPropsWithRef<'span'>, 'children'>"
    ],
    "props": {
      "className": {
        "optional": true,
        "type": [
          "string"
        ]
      },
      "line": {
        "optional": true,
        "type": [
          "\"a\"",
          "\"b\"",
          "\"bus\"",
          "\"c\"",
          "\"e\"",
          "\"f\"",
          "\"h\"",
          "\"m1\"",
          "\"m2\"",
          "\"m3\"",
          "\"m4\"",
          "\"regional\""
        ]
      },
      "ref": {
        "optional": true,
        "type": [
          "Ref<HTMLSpanElement>"
        ]
      },
      "render": {
        "optional": true,
        "type": [
          "RenderProp<Record<string, unknown>>"
        ]
      },
      "size": {
        "optional": true,
        "type": [
          "\"large\"",
          "\"medium\"",
          "\"small\""
        ]
      },
      "style": {
        "optional": true,
        "type": [
          "CSSProperties"
        ]
      },
      "variant": {
        "optional": true,
        "type": [
          "\"filled\"",
          "\"outlined\""
        ]
      }
    }
  }
}
