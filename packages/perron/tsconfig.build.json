{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    // a failed build writes nothing, so a stray tokens.js never lands beside tokens/generated/tokens.ts
    "noEmitOnError": true,
    "rewriteRelativeImportExtensions": true,
    // a component imports its own CSS, which scripts/copy-css.ts puts beside the built JS
    "noUncheckedSideEffectImports": false,
    "types": []
  },
  "include": ["src"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.stories.tsx",
    "src/**/fixtures",
    "src/testing"
  ]
}
