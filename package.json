{
  "name": "perron",
  "private": true,
  "version": "0.0.0",
  "description": "Perron, the design system of Mylder: design tokens and foundations.",
  "type": "module",
  "exports": {
    "./perron.css": "./styles/perron.css",
    "./tokens.css": "./tokens/generated/tokens.css",
    "./typography.css": "./tokens/generated/typography.css",
    "./tokens.ts": "./tokens/generated/tokens.ts",
    "./tokens/*.json": "./tokens/*.json"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.ts",
    "tokens:check": "node scripts/build-tokens.ts --check",
    "typecheck": "tsc",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run tokens:check && npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "@fontsource/familjen-grotesk": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/schibsted-grotesk": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
