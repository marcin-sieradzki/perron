{
  "name": "perron",
  "private": true,
  "version": "0.0.0",
  "description": "The Perron repository: the @mylder/perron and @mylder/perron-mcp packages, the token build, Storybook and the docs.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "tokens": "node scripts/build-tokens.ts",
    "tokens:check": "node scripts/build-tokens.ts --check",
    "registry": "node scripts/build-registry.ts",
    "registry:check": "node scripts/build-registry.ts --check",
    "typecheck": "tsc",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:stories": "vitest run --project stories --project fixtures",
    "test:watch": "vitest --project unit",
    "check": "npm run tokens:check && npm run registry:check && npm run typecheck && npm run gates && npm run lint && npm run format:check && npm run test && npm run test:stories",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o dist/storybook && node scripts/build-site.ts dist/storybook",
    "smoke": "node scripts/smoke-consumer.ts",
    "gates": "node scripts/checks/run.ts"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@mui/material": "9.5.0",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.5",
    "markdown-to-jsx": "^9.10.3",
    "oxlint": "^1.88.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
